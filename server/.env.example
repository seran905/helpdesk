DATABASE_URL="postgresql://<db-user>:<db-password>@localhost:5432/helpdesk?schema=public"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="<generate-a-unique-32-byte-secret>"
BETTER_AUTH_URL="http://localhost:3001"

CLIENT_URL="http://localhost:5173"

ADMIN_EMAIL="admin@example.com"
# Used only by `npx tsx prisma/seed.ts` to create the initial admin account — pick a strong password
ADMIN_PASSWORD="<choose-a-strong-password>"

# Shared secret the inbound-email webhook (POST /api/webhooks/inbound-email)
# checks against the x-webhook-secret request header. Generate with: openssl rand -base64 32
INBOUND_EMAIL_WEBHOOK_SECRET="<generate-a-unique-secret>"
